---
// Текстовый логотип по канону холдинга GPS24: {mark} + янтарный {accent},
// подпись-регион в mono-разрядку. Текст — из site.config (рабочее название).
import { SITE, type Lang } from '@config';
import { useTranslations } from '@/i18n';

interface Props {
  lang: Lang;
  tag?: boolean;
}

const { lang, tag = true } = Astro.props;
const t = useTranslations(lang);
---

<span class="logo__mark">{SITE.brand.mark}<b>{SITE.brand.accent}</b></span>
{tag && <span class="logo__tag">{t('brand.tagline')}</span>}
