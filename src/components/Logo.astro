---
// Текстовый логотип холдинг-страницы (решение владельца 10.08.2026):
// «GPS24» с янтарной «24» + подпись-регион в mono-разрядку.
// Прежний глиф остался только в public/favicon.svg.
import type { Lang } from '@config';
import { useTranslations } from '@/i18n';

interface Props {
  lang: Lang;
  tag?: boolean;
}

const { lang, tag = true } = Astro.props;
const t = useTranslations(lang);
---

<span class="logo__mark">GPS<b>24</b></span>
{tag && <span class="logo__tag">{t('brand.tagline')}</span>}
