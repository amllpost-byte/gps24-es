---
// Контакты: WhatsApp (единственный канал), email, зона обслуживания.
// Адреса и часов нет — физического магазина нет.
import { SITE, type Lang } from '@config';
import { useTranslations } from '@/i18n';
import { waLink } from '@/lib/whatsapp';
import BaseLayout from '@/components/BaseLayout.astro';
import Section from '@/components/Section.astro';
import WhatsAppCTA from '@/components/WhatsAppCTA.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const contactLine = `WhatsApp ${SITE.contact.whatsappDisplay} · ${SITE.contact.email}`;
const meta = {
  es: {
    title: `Contacto — ${SITE.name}`,
    description: `${contactLine} · Benidorm, Comunidad Valenciana.`,
  },
  en: {
    title: `Contact — ${SITE.name}`,
    description: `${contactLine} · Benidorm, Valencia region, Spain.`,
  },
  ru: {
    title: `Контакты — ${SITE.name}`,
    description: `${contactLine} · Бенидорм, регион Валенсия, Испания.`,
  },
}[lang];
---

<BaseLayout {lang} route="contacto" title={meta.title} description={meta.description}>
  <Section>
    <h1>{t('contact.title')}</h1>
    <div class="prose">
      <p>
        <a href={waLink(lang)}>WhatsApp {SITE.contact.whatsappDisplay}</a><br />
        <a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a>
      </p>
      <p class="lead">{SITE.hours.replyPromise[lang]}</p>
      <h2>{t('contact.areaTitle')}</h2>
      <p>{t('contact.cityLine')}</p>
      <p>{SITE.shipping[lang]}</p>
    </div>
    <div class="hero__cta">
      <WhatsAppCTA {lang} />
    </div>
  </Section>
</BaseLayout>
