---
// Cookies: правдивое состояние Этапа 1 — сайт не ставит cookies и не трекает.
// Если аналитика появится (только privacy-first, см. site.config) — обновить ДО включения.
import { SITE, type Lang } from '@config';
import { useTranslations } from '@/i18n';
import BaseLayout from '@/components/BaseLayout.astro';
import Section from '@/components/Section.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const meta = {
  es: { title: `Cookies — ${SITE.name}`, description: `Política de cookies de ${SITE.domain}.` },
  en: { title: `Cookies — ${SITE.name}`, description: `Cookie policy of ${SITE.domain}.` },
  ru: { title: `Cookies — ${SITE.name}`, description: `Политика cookies ${SITE.domain}.` },
}[lang];
---

<BaseLayout {lang} route="cookies" title={meta.title} description={meta.description}>
  <Section>
    <h1>{t('footer.cookies')}</h1>
    <div class="prose">
      <p>{t('legal.noCookies')}</p>
      <p>{t('legal.noCookiesNote')}</p>
    </div>
  </Section>
</BaseLayout>
