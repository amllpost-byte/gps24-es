---
// Сценарный лендинг «Грузовая навигация» + «услуга-крючок» — бесплатная
// консультация для камьонерос (приём Cowboy) + блок «Модель + цена» (ТЗ 02 §3).
// TODO(контент): полный лендинг по §3 (бандл, ТТХ-акценты, FAQ).
import { getCollection } from 'astro:content';
import type { Lang } from '@config';
import { useTranslations, localizePath } from '@/i18n';
import BaseLayout from '@/components/BaseLayout.astro';
import Section from '@/components/Section.astro';
import Button from '@/components/Button.astro';
import ProductCard from '@/components/ProductCard.astro';
import WhatsAppCTA from '@/components/WhatsAppCTA.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const navigators = (await getCollection('products'))
  .filter((p) => p.data.category === 'navigator')
  .sort((a, b) => a.data.price - b.data.price);

const meta = {
  es: {
    title: 'GPS para camiones — GPS24 Benidorm',
    description:
      'Navegadores GPS para camión: rutas con restricciones de altura, peso y mercancías peligrosas. Consulta gratuita por WhatsApp.',
  },
  en: {
    title: 'Truck GPS — GPS24 Benidorm',
    description:
      'Truck sat navs: routing with height, weight and dangerous-goods restrictions. Free consultation on WhatsApp.',
  },
  ru: {
    title: 'GPS для грузовиков — GPS24 Бенидорм',
    description:
      'GPS-навигаторы для грузовиков: маршруты с учётом высоты, веса и опасных грузов. Бесплатная консультация в WhatsApp.',
  },
}[lang];
---

<BaseLayout {lang} route="gps-para-camiones" title={meta.title} description={meta.description}>
  <Section class="hero">
    <h1>{t('truck.title')}</h1>
    <p class="lead">{t('truck.lead')}</p>
    <div class="hero__cta">
      <WhatsAppCTA {lang} label={t('cta.freeConsult')} />
      <Button variant="secondary" href={localizePath('tienda', lang)}>{t('cta.viewCatalog')}</Button>
    </div>
  </Section>
  {
    navigators.length > 0 && (
      <Section divider>
        <h2>{t('truck.modelsTitle')}</h2>
        <div class="product-grid">
          {navigators.map((product) => (
            <ProductCard {lang} {product} />
          ))}
        </div>
      </Section>
    )
  }
</BaseLayout>
