---
// Сравнение до 3 моделей. Каталог опубликован 10.08.2026, но island
// CompareTable (client:visible) ещё не построен (backlog STATE §6 п.3) —
// до него показываем честную заглушку со ссылкой на каталог.
import type { Lang } from '@config';
import { useTranslations, localizePath } from '@/i18n';
import BaseLayout from '@/components/BaseLayout.astro';
import Section from '@/components/Section.astro';
import Button from '@/components/Button.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const meta = {
  es: { title: 'Comparar modelos — GPS24', description: 'Compare hasta 3 navegadores GPS de nuestro catálogo.' },
  en: { title: 'Compare models — GPS24', description: 'Compare up to 3 GPS navigators from our catalogue.' },
  ru: { title: 'Сравнение моделей — GPS24', description: 'Сравните до 3 GPS-навигаторов из нашего каталога.' },
}[lang];
---

<BaseLayout {lang} route="comparar" title={meta.title} description={meta.description} noindex>
  <Section>
    <h1>{t('cta.compare')}</h1>
    <div class="empty-state">
      <p>{t('compare.empty')}</p>
      <Button variant="secondary" href={localizePath('tienda', lang)}>
        {t('cta.viewCatalog')}
      </Button>
    </div>
  </Section>
</BaseLayout>
