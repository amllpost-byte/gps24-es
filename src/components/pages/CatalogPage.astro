---
// Каталог-прайс одной страницей (ТЗ 02 §2): группы по категориям с якорями,
// внутри группы сортировка по цене по возрастанию
// (правило владельца с naviseade), якорные чипы при ≥2 группах и замыкающая
// полоса-консультация. Пустые группы не рендерятся; при пустой коллекции —
// честный empty-state с WhatsApp, без фейковых карточек.
import { getCollection } from 'astro:content';
import type { Lang } from '@config';
import { useTranslations } from '@/i18n';
import BaseLayout from '@/components/BaseLayout.astro';
import Section from '@/components/Section.astro';
import ProductCard from '@/components/ProductCard.astro';
import WhatsAppCTA from '@/components/WhatsAppCTA.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const products = await getCollection('products');

const byPrice = (a: (typeof products)[number], b: (typeof products)[number]) => a.data.price - b.data.price;
const groups = (
  [
    // регистраторы убраны 11.08 (отдельный сайт); accessory — задел под
    // будущие аксессуары для навигаторов
    { id: 'navegadores', titleKey: 'nav.navigators', category: 'navigator' },
    { id: 'accesorios', titleKey: 'catalog.accessories', category: 'accessory' },
  ] as const
)
  .map((g) => ({ ...g, items: products.filter((p) => p.data.category === g.category).sort(byPrice) }))
  .filter((g) => g.items.length > 0);

const meta = {
  es: {
    title: 'Catálogo y precios — GPS24',
    description:
      'Todos nuestros navegadores GPS para camión con precios en una página. Envíos a toda España desde Estonia (UE).',
  },
  en: {
    title: 'Catalogue and prices — GPS24',
    description: 'All our truck GPS navigators with prices on one page. Shipping across Spain from Estonia (EU).',
  },
  ru: {
    title: 'Каталог и цены — GPS24',
    description: 'Все наши грузовые GPS-навигаторы с ценами на одной странице. Доставка по всей Испании из Эстонии (ЕС).',
  },
}[lang];
---

<BaseLayout {lang} route="tienda" title={meta.title} description={meta.description}>
  <Section>
    <h1>{t('catalog.title')}</h1>
    <p class="lead">{t('catalog.lead')}</p>
    {
      groups.length === 0 ? (
        <div class="empty-state">
          <p>{t('catalog.empty')}</p>
          <WhatsAppCTA {lang} />
        </div>
      ) : (
        <>
          {groups.length >= 2 && (
            <nav class="catalog-chips" aria-label={t('catalog.title')}>
              {groups.map((g) => (
                <a class="badge badge--neutral" href={`#${g.id}`}>
                  {t(g.titleKey)}
                </a>
              ))}
            </nav>
          )}
          {groups.map((g) => (
            <section class="catalog-group" id={g.id}>
              <h2>{t(g.titleKey)}</h2>
              <div class="product-grid">
                {g.items.map((product) => (
                  <ProductCard {lang} {product} />
                ))}
              </div>
            </section>
          ))}
          <div class="service-block catalog-consult">
            <p>{t('catalog.consultLead')}</p>
            <WhatsAppCTA {lang} />
          </div>
        </>
      )
    }
  </Section>
</BaseLayout>
