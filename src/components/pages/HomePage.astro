---
// Главная: hero → trust-бар → сценарии → товарная сетка → услуга → B2B-вставка
// (канон: 6–8 секций). TODO(контент): hero одного конкретного товара с ценой
// (канон §Главная-1).
import { getCollection } from 'astro:content';
import type { Lang } from '@config';
import { useTranslations, localizePath } from '@/i18n';
import BaseLayout from '@/components/BaseLayout.astro';
import Section from '@/components/Section.astro';
import Button from '@/components/Button.astro';
import WhatsAppCTA from '@/components/WhatsAppCTA.astro';
import TrustBar from '@/components/TrustBar.astro';
import ScenarioTiles from '@/components/ScenarioTiles.astro';
import ServiceBlock from '@/components/ServiceBlock.astro';
import ProductCard from '@/components/ProductCard.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
// витрина главной: навигаторы, затем регистраторы, по цене; первые 8 —
// полный ассортимент на /tienda (кнопка под сеткой)
const catOrder = { navigator: 0, dashcam: 1, accessory: 2 } as const;
const featured = (await getCollection('products'))
  .sort((a, b) => catOrder[a.data.category] - catOrder[b.data.category] || a.data.price - b.data.price)
  .slice(0, 8);

const meta = {
  es: {
    title: 'GPS para camiones en España — GPS24',
    description:
      'Navegadores GPS para camión con 3D Navi Truck y actualización de mapas. Precios claros, garantía de 3 años. WhatsApp +34 637 792 222.',
  },
  en: {
    title: 'Truck GPS in Spain — GPS24',
    description:
      'Truck sat navs with 3D Navi Truck and map updates. Clear prices, 3-year warranty. WhatsApp +34 637 792 222.',
  },
  ru: {
    title: 'GPS для грузовиков в Испании — GPS24',
    description:
      'GPS-навигаторы для грузовиков с 3D Navi Truck и обновление карт. Понятные цены, гарантия 3 года. WhatsApp +34 637 792 222.',
  },
}[lang];
---

<BaseLayout {lang} route="" title={meta.title} description={meta.description}>
  <Section class="hero">
    <h1>{t('home.heroTitle')}</h1>
    <p class="lead">{t('home.heroLead')}</p>
    <div class="hero__cta">
      <WhatsAppCTA {lang} />
      <Button variant="secondary" href={localizePath('tienda', lang)}>{t('cta.viewCatalog')}</Button>
    </div>
  </Section>
  {/* линия маршрута сразу под hero — видна с первого экрана (владелец, 11.08) */}
  <Section divider>
    <TrustBar {lang} />
  </Section>
  <Section>
    <h2>{t('home.scenariosTitle')}</h2>
    <ScenarioTiles {lang} />
  </Section>
  {
    featured.length > 0 && (
      <Section>
        {/* товарная сетка С4 (ТЗ 02 §1): цены видны с главной, не «за редиректом» */}
        <h2>{t('catalog.title')}</h2>
        <div class="product-grid">
          {featured.map((product) => (
            <ProductCard {lang} {product} />
          ))}
        </div>
        <div class="hero__cta">
          <Button variant="secondary" href={localizePath('tienda', lang)}>{t('cta.viewCatalog')}</Button>
        </div>
      </Section>
    )
  }
  <Section divider>
    <ServiceBlock {lang} />
  </Section>
  <Section tone="dark">
    <h2>{t('home.fleetTitle')}</h2>
    <p>{t('home.fleetLead')}</p>
    <div class="hero__cta">
      <Button variant="primary" href={localizePath('flotas', lang)}>{t('nav.fleets')}</Button>
    </div>
  </Section>
</BaseLayout>
