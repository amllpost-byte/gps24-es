---
// B2B-лендинг «Автопаркам»: тёмная эстетика, CTA — расчёт в WhatsApp.
// TODO(контент): сверить с ТЗ раздел 4 (кейсы, калькулятор экономии — приём Webfleet).
import type { Lang } from '@config';
import { useTranslations } from '@/i18n';
import BaseLayout from '@/components/BaseLayout.astro';
import Section from '@/components/Section.astro';
import TrustBar from '@/components/TrustBar.astro';
import WhatsAppCTA from '@/components/WhatsAppCTA.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const meta = {
  es: {
    title: 'GPS para flotas de camiones — GPS24 Benidorm',
    description:
      'Equipamiento GPS para flotas de camiones: presupuesto por WhatsApp, actualización de mapas incluida.',
  },
  en: {
    title: 'GPS for truck fleets — GPS24 Benidorm',
    description: 'GPS equipment for truck fleets: quote via WhatsApp, map updates included.',
  },
  ru: {
    title: 'GPS для автопарков — GPS24 Бенидорм',
    description: 'GPS-оснащение автопарков: расчёт в WhatsApp, обновление карт включено.',
  },
}[lang];
---

<BaseLayout {lang} route="flotas" title={meta.title} description={meta.description}>
  <Section class="hero">
    <h1>{t('fleet.title')}</h1>
    <p class="lead">{t('home.fleetLead')}</p>
    <div class="hero__cta">
      <WhatsAppCTA {lang} label={t('cta.quote')} />
    </div>
  </Section>
  <Section>
    <TrustBar {lang} />
  </Section>
</BaseLayout>
