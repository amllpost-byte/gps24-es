---
// Услуга «Установка видеорегистратора». Цена desde — из content/services
// (владелец, 11.08: «от 50»). Срок/«что входит» не показываем, пока пусто
// в данных: формат согласуется в WhatsApp.
import { getEntry } from 'astro:content';
import type { Lang } from '@config';
import { useTranslations } from '@/i18n';
import { formatPrice } from '@/lib/format';
import BaseLayout from '@/components/BaseLayout.astro';
import Section from '@/components/Section.astro';
import Badge from '@/components/Badge.astro';
import WhatsAppCTA from '@/components/WhatsAppCTA.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const service = await getEntry('services', 'dashcam-install');

const meta = {
  es: {
    title: 'Instalación de dashcam — desde 50 € — GPS24',
    description: 'Instalación profesional de dashcams desde 50 €. Consulte precio y cita por WhatsApp +34 637 792 222.',
  },
  en: {
    title: 'Dashcam installation — from €50 — GPS24',
    description: 'Professional dashcam installation from €50. Ask for price and booking on WhatsApp +34 637 792 222.',
  },
  ru: {
    title: 'Установка видеорегистратора — от 50 € — GPS24',
    description: 'Профессиональная установка видеорегистраторов от 50 €. Цена и запись — в WhatsApp +34 637 792 222.',
  },
}[lang];
---

<BaseLayout {lang} route="instalacion-dashcam" title={meta.title} description={meta.description}>
  <Section class="hero">
    <h1>{t('install.title')}</h1>
    <p class="lead">{t('install.lead')}</p>
    {
      service && (
        <p class="service-price">
          <span class="price price--lg">{`${t('service.from')} ${formatPrice(service.data.priceFrom)} €`}</span>
          {service.data.turnaround[lang] && <Badge tone="amber">{service.data.turnaround[lang]}</Badge>}
        </p>
      )
    }
    <div class="hero__cta">
      <WhatsAppCTA {lang} />
    </div>
    {
      service && service.data.includes.length > 0 && (
        <ul>
          {service.data.includes.map((item) => (
            <li>{item[lang]}</li>
          ))}
        </ul>
      )
    }
  </Section>
</BaseLayout>
