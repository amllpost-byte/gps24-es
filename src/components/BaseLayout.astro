---
// Каркас каждой страницы: <html lang> + Head + skip-link + Header + main + Footer.
// Шрифты — self-hosted через Fontsource (variable, сабсеты latin+cyrillic), без CDN.
import '@fontsource-variable/overpass';
import '@fontsource-variable/overpass-mono';
import '@/styles/tokens.css';
import '@/styles/base.css';
import '@/styles/components.css';
import type { Lang } from '@config';
import { useTranslations, type RouteKey } from '@/i18n';
import Head from './Head.astro';
import Header from './Header.astro';
import LaunchNotice from './LaunchNotice.astro';
import Footer from './Footer.astro';

interface Props {
  lang: Lang;
  route: RouteKey;
  rest?: string;
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: object[];
  ogImage?: { url: string; width?: number | string; height?: number | string };
}

const { lang, route, rest = '', title, description, noindex, jsonLd, ogImage } = Astro.props;
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <Head {lang} {route} {rest} {title} {description} {noindex} {jsonLd} {ogImage} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('a11y.skipToContent')}</a>
    <Header {lang} {route} {rest} />
    <LaunchNotice {lang} />
    <main id="main">
      <slot />
    </main>
    <Footer {lang} />
  </body>
</html>
