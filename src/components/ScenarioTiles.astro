---
// Плитки «для кого» — группировка по сценарию покупателя, не по бренду (канон).
import type { Lang } from '@config';
import { useTranslations, localizePath, type RouteKey, type UIKey } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const icons = {
  truck:
    '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 8h16v14H2zM18 13h6l4 5v4h-10z"/><circle cx="8" cy="24" r="2.5"/><circle cx="23" cy="24" r="2.5"/></svg>',
  dashcam:
    '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="9" width="17" height="12" rx="2"/><path d="M21 13l7-3v10l-7-3"/><circle cx="12" cy="15" r="3"/></svg>',
  maps:
    '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8l8-3 8 3 8-3v19l-8 3-8-3-8 3z"/><path d="M12 5v19M20 8v19"/></svg>',
  fleet:
    '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h12v10H3zM9 8h12v4M15 4h12v4"/><circle cx="7" cy="24" r="2"/><circle cx="12" cy="24" r="2"/><path d="M15 17h12v5H15z"/><circle cx="19" cy="24" r="2"/><circle cx="24" cy="24" r="2"/></svg>',
} as const;

const tiles: { key: UIKey; route: RouteKey; icon: keyof typeof icons }[] = [
  { key: 'scenario.truck', route: 'gps-para-camiones', icon: 'truck' },
  { key: 'scenario.dashcam', route: 'tienda', icon: 'dashcam' },
  { key: 'scenario.maps', route: 'actualizacion-de-mapas', icon: 'maps' },
  { key: 'scenario.fleet', route: 'flotas', icon: 'fleet' },
];
---

<ul class="scenario-tiles" role="list">
  {
    tiles.map((tile) => (
      <li>
        <a href={localizePath(tile.route, lang)}>
          <Fragment set:html={icons[tile.icon]} />
          <span>{t(tile.key)}</span>
        </a>
      </li>
    ))
  }
</ul>
