---
// Блок «сервис в WhatsApp на вашем языке» — главный дифференциатор ниши
// (исследование 11.08: языки + WhatsApp против федеральных операторов).
// CTA — приём «пришлите фото/план жилья»: конкретное действие вместо «звоните».
import type { Lang } from '@config';
import { useTranslations } from '@/i18n';
import WhatsAppCTA from './WhatsAppCTA.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="service-block">
  <h2>{t('home.serviceTitle')}</h2>
  <p>{t('home.serviceLead')}</p>
  <WhatsAppCTA {lang} label={t('service.sendPhotos')} />
</div>
