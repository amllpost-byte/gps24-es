---
// Шапка: лого + меню 6 пунктов (по сценариям, не по брендам) + LangSwitch + почта
// обычной mailto-ссылкой (владелец, 11.08: WhatsApp в шапке лишний, почта должна
// открывать письмо как обычно). Мобильное меню — <details>, JS нет.
import { SITE, type Lang } from '@config';
import { useTranslations, localizePath, type RouteKey, type UIKey } from '@/i18n';
import LangSwitch from './LangSwitch.astro';
import MobileMenu from './MobileMenu.astro';
import Button from './Button.astro';
import Logo from './Logo.astro';

interface Props {
  lang: Lang;
  route: RouteKey;
  rest?: string;
}

const { lang, route, rest = '' } = Astro.props;
const t = useTranslations(lang);

export type NavItem = { key: UIKey; route: RouteKey; hash?: string };
const navItems: NavItem[] = [
  { key: 'nav.navigators', route: 'gps-para-camiones' },
  // лендинга /dashcams пока нет — честная якорная секция каталога (ревью 11.08)
  { key: 'nav.dashcams', route: 'tienda', hash: '#dashcams' },
  { key: 'nav.mapUpdates', route: 'actualizacion-de-mapas' },
  { key: 'nav.fleets', route: 'flotas' },
  { key: 'nav.support', route: 'soporte' },
  { key: 'nav.contact', route: 'contacto' },
];
---

<header class="site-header">
  <div class="container site-header__row">
    <a class="logo" href={localizePath('', lang)}>
      <Logo {lang} />
    </a>
    <nav class="nav-desktop" aria-label={t('a11y.mainNav')}>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={localizePath(item.route, lang) + (item.hash ?? '')} aria-current={item.route === route ? 'page' : undefined}>
                {t(item.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="site-header__actions">
      <LangSwitch {lang} {route} {rest} />
      <Button variant="secondary" href={`mailto:${SITE.contact.email}`} small>
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
        {SITE.contact.email}
      </Button>
      <MobileMenu {lang} {route} items={navItems} />
    </div>
  </div>
</header>
