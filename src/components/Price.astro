---
// Цена: Overpass Mono + tabular-nums (класс .price из tokens.css), формат по ТЗ
// §1.3.1 (см. lib/format.ts). large — крупная цена бай-бокса (price-lg 36/28).
import { formatPrice } from '@/lib/format';

interface Props {
  amount: number;
  note?: string;
  large?: boolean;
}

const { amount, note, large = false } = Astro.props;
---

<span class:list={['price', large && 'price--lg']}>{`${formatPrice(amount)} €`}</span>{note && <span class="price__note">{note}</span>}
