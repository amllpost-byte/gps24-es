---
// Главный CTA сайта: wa.me с предзаполненным текстом (generic или про товар).
import type { Lang } from '@config';
import { useTranslations } from '@/i18n';
import { waLink } from '@/lib/whatsapp';
import Button from './Button.astro';

interface Props {
  lang: Lang;
  product?: string;
  label?: string;
  small?: boolean;
}

const { lang, product, label, small = false } = Astro.props;
const t = useTranslations(lang);
---

<Button variant="whatsapp" href={waLink(lang, product)} {small}>
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.7-1.2A9 9 0 1 0 12 3Z"></path>
    <path d="M8.7 9.2c.3-.8.9-.9 1.3-.4l.8 1c.2.3.2.6 0 .9l-.4.6c.5 1 1.3 1.8 2.3 2.3l.6-.4c.3-.2.6-.2.9 0l1 .8c.5.4.4 1-.4 1.3-1.2.5-2.6.1-4.2-1.5-1.6-1.6-2-3-1.5-4.2Z" fill="currentColor" stroke="none"></path>
  </svg>
  {label ?? t('cta.whatsapp')}
</Button>
