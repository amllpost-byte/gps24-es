---
// 404 — одна на сайт (GitHub Pages отдаёт /404.html для всех путей).
// Базовый язык ES + ссылки на главные всех трёх локалей.
import { SITE } from '@config';
import { useTranslations, localizePath } from '@/i18n';
import BaseLayout from '@/components/BaseLayout.astro';
import Section from '@/components/Section.astro';
import Button from '@/components/Button.astro';

const t = useTranslations('es');
---

<BaseLayout lang="es" route="" title={`404 — ${SITE.name}`} description={t('notFound.body')} noindex>
  <Section class="hero">
    <h1>{t('notFound.title')}</h1>
    <p class="lead">{t('notFound.body')}</p>
    <div class="hero__cta">
      <Button variant="primary" href={localizePath('', 'es')}>{t('notFound.home')}</Button>
      <Button variant="secondary" href={localizePath('', 'en')}>English</Button>
      <Button variant="secondary" href={localizePath('', 'ru')}>Русский</Button>
    </div>
  </Section>
</BaseLayout>
